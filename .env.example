# Copy to .env (git-ignored) and fill in. run.ps1 loads it before starting the app.
# Leave DB_URL empty (or delete .env) to use the local H2 database instead.

# Neon: the JDBC URL *without* user/password — those go in the two variables below.
DB_URL=jdbc:postgresql://<your-neon-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USERNAME=
DB_PASSWORD=

# Optional answer reviewers. Easier: paste the keys on the app's Settings page instead.
# Without any key, answers get the offline term check.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
